# Copy to .env and fill in real values before running docker compose up.
# Never commit a real .env file.

POSTGRES_USER=sigmaforge
POSTGRES_PASSWORD=change-me
POSTGRES_DB=sigmaforge

MINIO_ROOT_USER=sigmaforge
MINIO_ROOT_PASSWORD=change-me-too

# Generate a real RSA keypair for these -- see README.md "Generating JWT keys".
# Never use a keypair checked into source control.
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
